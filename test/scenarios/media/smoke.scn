# Smoke test for media_player. With test/fixtures/sd/movie/sample.mjpeg
# in place, tf.listDir("/movie") returns a one-entry File_Info list, so
# init's video_start(false) actually constructs an MjpegPlayDecoder
# (mallocs buffers, calls tft->initDMA) instead of returning early.
# media_player has no LVGL screen of its own — frames go straight to
# tft->pushImageDMA, which is a stub no-op on host — so the captured
# screen is the controller's app icon. The test value is "init +
# decoder construction + first process tick survive".

app media

wait_ms 400
action TURN_RIGHT
wait_ms 400
screenshot 01_after_turn_right
assert_no_crash

action RETURN
wait_ms 200
assert_no_crash
