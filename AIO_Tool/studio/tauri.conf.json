{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoloCubic AIO Studio",
  "version": "3.0.0",
  "identifier": "io.holocubic.aio-studio",
  "build": {
    "frontendDist": "../../Docs/design/studio-flasher",
    "devUrl": "http://localhost:8765"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HoloCubic AIO Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
