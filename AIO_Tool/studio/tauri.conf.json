{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoloCubic AIO Studio",
  "version": "3.1.1",
  "identifier": "io.holocubic.aio-studio",
  "build": {
    "frontendDist": "../../Docs/design/studio-flasher",
    "devUrl": "http://localhost:8765"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HoloCubic AIO Studio",
        "width": 1280,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "HoloCubic AIO Studio",
    "longDescription": "Cross-platform flasher, settings, file manager and converter for the HoloCubic ESP32 toy.",
    "publisher": "HoloCubic AIO",
    "copyright": "MIT OR Apache-2.0",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
